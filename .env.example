# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase.
# Solo las variables con prefijo VITE_ se exponen al navegador.
# La anon key es pública por diseño; NUNCA pongas la service_role key aquí.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Opcional: correo real detrás del usuario corto "admin" del login.
# VITE_ADMIN_EMAIL=admin@popular.com
# VITE_ADMIN_PASSWORD=admin123

# Acceso de administrador local sin Supabase Auth (usuario: admin).
# Desactivar con VITE_LOCAL_ADMIN=false.
VITE_LOCAL_ADMIN=true

# Solo para `npm run admin:create` (script local). NUNCA lleva prefijo VITE_,
# así Vite no la incluye en el bundle del navegador.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
